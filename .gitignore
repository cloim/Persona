# 운영체제 아티팩트 (OS artifacts)
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# IDE 및 에디터 설정 (IDE & Editor settings)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 빌드 및 런타임 캐시 (Build & Runtime cache)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
.turbo/
.cache/

# 패키지 의존성 (Package dependencies)
node_modules/
.pnpm-store/
.venv/
env/
venv/
ENV/

# 환경변수 파일 (Environment variables)
.env
.env.*
!.env.example

# 개발 및 설계 문서 경로 (Development & design documents)
docs/

# 로그 파일 (Log files)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
